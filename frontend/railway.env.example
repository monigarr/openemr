# Copy variable NAMES and values into Railway → PRD2 Modernized service → Variables.
# Do not commit real secrets. OpenEMR (Track A) stays on its own Railway service/URL.
#
# --- Public URLs (staging) ---
# NEXTAUTH_URL and AUTH_URL must be the canonical HTTPS origin of THIS Next.js service
# (Railway-generated domain or your custom domain), no trailing slash.
NEXTAUTH_URL=""
AUTH_URL=""
#
# --- Auth.js ---
AUTH_SECRET="use-openssl-rand-hex-32-one-line"
#
# --- OpenEMR OAuth client (register in OpenEMR: Administration → System → API Clients
#     or SMART app registration / interface/smart/register-app.php) ---
# Redirect URI must match exactly:
#   {NEXTAUTH_URL}/api/auth/callback/openemr
AUTH_OPENEMR_ID=""
AUTH_OPENEMR_SECRET=""
#
# Issuer and API base = your Track A OpenEMR service public URL (same branch/env as PRD 2).
OPENEMR_OAUTH2_ISSUER=""
OPENEMR_BASE_URL=""
# Optional if discovery doc token URL differs:
# OPENEMR_OAUTH2_TOKEN_URL=""
# OpenEMR (see .env.example)
OPENEMR__ENVIRONMENT=
OPENEMR__NO_BACKGROUND_TASKS=
OPENEMR_PRD2_BASE_URL=""
OPENEMR_PRD2_MODERNIZED_BASE_URL=""
#
# --- Optional: Langfuse (Track B observability; see docker/agentforge-railway/README.md) ---
# --- Langfuse: Clinical Co-Pilot observability (optional) ---
# Also enable: Admin → Config → Portal → Clinical Co-Pilot: allow Langfuse observability export.
LANGFUSE_SECRET_KEY=""
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_BASE_URL=""
# Optional kill switch (omit or use 1/true to allow export when keys + Globals are on):
# use 0 false to disable export even when toggle and keys are setup
LANGFUSE_ENABLED=true
# Omit for metadata-only; use redacted only for non-PHI / approved dev:
# LANGFUSE_CLINICAL_COPILOT_IO=redacted
# LANGFUSE_IO_MAX_CHARS=500
# LANGFUSE_ID_SALT=
# LANGSMITH
# LANGSMITH_API_KEY=""
#
# --- TLS (avoid in production; only if OpenEMR uses self-signed certs Node does not trust) ---
# NODE_TLS_REJECT_UNAUTHORIZED=0

# OpenAI API key
OPENAI_API_KEY=""
GEMINI_API_KEY=""
LLAMA_API_KEY=""

