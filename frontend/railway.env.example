# Copy variable NAMES and values into Railway → PRD2 Modernized service → Variables.
# Do not commit real secrets. OpenEMR (Track A) stays on its own Railway service/URL.
#
# --- Public URLs (staging) ---
# NEXTAUTH_URL and AUTH_URL must be the canonical HTTPS origin of THIS Next.js service
# (Railway-generated domain or your custom domain), no trailing slash.
NEXTAUTH_URL="https://your-next-app.up.railway.app"
AUTH_URL="https://your-next-app.up.railway.app"
#
# --- Auth.js ---
AUTH_SECRET="use-openssl-rand-hex-32-one-line"
#
# --- OpenEMR OAuth client (register in OpenEMR: Administration → System → API Clients
#     or SMART app registration / interface/smart/register-app.php) ---
# Redirect URI must match exactly:
#   {NEXTAUTH_URL}/api/auth/callback/openemr
AUTH_OPENEMR_ID="your-oauth-client-id"
AUTH_OPENEMR_SECRET="your-oauth-client-secret"
#
# Issuer and API base = your Track A OpenEMR service public URL (same branch/env as PRD 2).
OPENEMR_OAUTH2_ISSUER="https://your-openemr.up.railway.app/oauth2/default"
OPENEMR_BASE_URL="https://your-openemr.up.railway.app"
# Optional if discovery doc token URL differs:
# OPENEMR_OAUTH2_TOKEN_URL="https://your-openemr.up.railway.app/oauth2/default/token"
#
# --- Optional: Langfuse (Track B observability; see docker/agentforge-railway/README.md) ---
# DASHBOARD_LANGFUSE_ENABLE=1
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://hipaa.cloud.langfuse.com
#
# --- TLS (avoid in production; only if OpenEMR uses self-signed certs Node does not trust) ---
# NODE_TLS_REJECT_UNAUTHORIZED=0
