# Copy to `.env.local` for local development (never commit `.env.local`).
# Railway staging / production (Track B): see `railway.env.example` and `docker/agentforge-railway/README.md`.
#
# Local OpenEMR (docker/development-easy) uses self-signed TLS on :9300. For Node fetch (OIDC discovery + FHIR proxy),
# either trust that CA (recommended) or use DEV-ONLY (remove in production):
# NODE_TLS_REJECT_UNAUTHORIZED=0
#
# Auth.js / NextAuth — AUTH_SECRET must be ONE line (no embedded newlines).
AUTH_SECRET="replace-with-openssl-rand-hex-32"
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# OpenEMR OAuth client (register in OpenEMR admin; redirect URI must include /api/auth/callback/openemr)
AUTH_OPENEMR_ID="your-oauth-client-id"
AUTH_OPENEMR_SECRET="your-oauth-client-secret"

# OpenEMR OIDC issuer (example for easy dev)
# OPENEMR_OAUTH2_ISSUER="https://localhost:9300/oauth2/default"
OPENEMR_OAUTH2_ISSUER="https://your-openemr-instance/oauth2/default"

# Optional override if your discovery doc uses a non-default token URL
# OPENEMR_OAUTH2_TOKEN_URL="https://your-openemr-instance/oauth2/default/token"

# OpenEMR base URL for FHIR proxying (no trailing slash required)
OPENEMR_BASE_URL="https://your-openemr-instance"
