{% extends "patient/card/card_base.html.twig" %}
{#
  SPDX-License-Identifier: GPL-3.0-only
  Clinical Co-Pilot — multi-turn chat, citations, briefing (DEMO).
#}

{% block content %}
<style>
    #clinical-copilot-root {
        --of-primary:rgb(23, 166, 114);
        --of-primary-hover:rgb(18, 124, 83);
        --of-primary-active:rgb(11, 90, 35);
        --of-accent:rgb(47, 237, 113);
        --of-bg: #F3F7FC;
        --of-surface: #FFFFFF;
        --of-text: #1F2933;
        --of-muted: #52616B;
        --of-border: #B8C7D9;
        --of-focus: #F9AB00;

        background: var(--of-bg);
        border-left: 8px solid var(--of-accent);
        border-top: 1px solid var(--of-border);
        border-right: 1px solid var(--of-border);
        border-bottom: 1px solid var(--of-border);
        border-radius: 14px;
        padding: 1rem;
        box-shadow: 0 6px 18px rgba(15, 23, 42, 0.16);
        color: var(--of-text);
    }

    #clinical-copilot-root .copilot-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 0.75rem;
    }

    #clinical-copilot-root .copilot-kicker {
        font-size: 0.82rem;
        font-weight: 800;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--of-primary);
        margin-bottom: 0.2rem;
    }

    #clinical-copilot-root .copilot-subtitle {
        font-size: 0.95rem;
        color: var(--of-muted);
        margin: 0;
        max-width: 42rem;
    }

    #clinical-copilot-root .copilot-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 0.85rem;
    }

    #clinical-copilot-root .btn-of-primary {
        background: var(--of-primary);
        border: 2px solid var(--of-primary);
        color: #FFFFFF !important;
        font-size: 1.05rem;
        font-weight: 800;
        padding: 0.8rem 1.15rem;
        border-radius: 10px;
        min-height: 48px;
        box-shadow: 0 3px 8px rgba(23, 166, 161, 0.28);
    }

    #clinical-copilot-root .btn-of-primary:hover {
        background: var(--of-primary-hover);
        border-color: var(--of-primary-hover);
    }

    #clinical-copilot-root .btn-of-primary:active {
        background: var(--of-primary-active);
        border-color: var(--of-primary-active);
    }

    #clinical-copilot-root .btn-of-secondary {
        background: var(--of-surface);
        border: 2px solid var(--of-border);
        color: var(--of-text) !important;
        font-size: 0.95rem;
        font-weight: 700;
        padding: 0.75rem 1rem;
        border-radius: 10px;
        min-height: 48px;
    }

    #clinical-copilot-root button:focus-visible,
    #clinical-copilot-root textarea:focus-visible {
        outline: 4px solid var(--of-focus);
        outline-offset: 2px;
        box-shadow: none;
    }

    #clinical-copilot-transcript {
        background: var(--of-surface) !important;
        border: 1px solid var(--of-border) !important;
        border-radius: 10px !important;
        padding: 0.75rem !important;
        margin-bottom: 0.85rem !important;
    }

    #clinical-copilot-root .copilot-user-bubble {
        background: var(--of-primary);
        color: #FFFFFF;
    }

    #clinical-copilot-root .copilot-assistant-bubble {
        background: #FFFFFF;
        color: var(--of-text);
        border: 1px solid var(--of-border);
    }

    #clinical-copilot-root .copilot-bubble {
        border-radius: 10px;
        padding: 0.55rem 0.7rem;
        max-width: 95%;
        font-size: 1rem;
        line-height: 1.45;
    }

    #clinical-copilot-sources {
        background: #FFFFFF;
        border: 1px solid var(--of-border);
        border-radius: 10px;
        padding: 0.75rem;
    }

    #clinical-copilot-sources .font-weight-bold {
        color: var(--of-primary);
        font-size: 0.95rem;
        margin-bottom: 0.4rem;
        display: block;
    }

    #clinical-copilot-input {
        font-size: 1rem !important;
        min-height: 48px;
        border: 2px solid var(--of-border);
        border-radius: 10px;
    }

    #clinical-copilot-send-btn {
        min-height: 48px;
        border-radius: 10px;
        font-weight: 800;
    }

    #clinical-copilot-root details summary {
        font-size: 0.9rem;
        font-weight: 700;
        color: var(--of-muted);
        cursor: pointer;
    }
</style>
<div class="clinical-copilot-panel ml-1 mr-1 mb-2" id="clinical-copilot-root"
     data-ajax-url="{{ copilotAjaxUrl|attr }}" data-csrf="{{ csrf|attr }}">
    
    <div class="copilot-header">
        <div>
            <div class="copilot-kicker">{{ "Verified Clinical Co-Pilot"|xlt }}</div>
            <p class="copilot-subtitle">
                {{ "Fast chart-grounded briefing for the next patient. Citations reference chart tools only. Demo data only."|xlt }}
            </p>
        </div>
    </div>

    <div class="copilot-actions" role="group" aria-label="{{ "Clinical co-pilot actions"|xlt }}">
        <button type="button" class="btn btn-of-primary" id="clinical-copilot-brief-btn">
            <i class="fa fa-magic mr-1"></i> {{ "Generate Patient Brief"|xlt }}
        </button>
        <button type="button" class="btn btn-of-secondary" id="clinical-copilot-reset-btn">
            {{ "Clear Thread"|xlt }}
        </button>
    </div>

    <div class="copilot-upload mb-2" role="region" aria-label="{{ "Upload clinical document (demo PDF)"|xlt }}">
        <label for="clinical-copilot-file" class="d-block font-weight-bold mb-1">{{ "Demo PDF upload (lab or intake)"|xlt }}</label>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <input type="file" id="clinical-copilot-file" class="form-control-file" accept="application/pdf" />
            <label for="clinical-copilot-doctype" class="sr-only">{{ "Document type"|xlt }}</label>
            <select id="clinical-copilot-doctype" class="form-control form-control-sm" style="width:auto;min-width:10rem;">
                <option value="lab_pdf">{{ "lab PDF"|xlt }}</option>
                <option value="intake_form">{{ "intake form"|xlt }}</option>
            </select>
            <button type="button" class="btn btn-of-secondary" id="clinical-copilot-upload-btn">{{ "Stage upload"|xlt }}</button>
        </div>
        <p class="text-muted large mb-0 mt-1">{{ "PDF only for demo. After staging, run a briefing or ask a question so the agent can call attach_and_extract."|xlt }}</p>
    </div>

    <div id="clinical-copilot-transcript"
         class="border rounded bg-white p-2 mb-2"
         style="max-height: 22rem; overflow-y: auto;"
         aria-live="polite"
         aria-label="{{ "Clinical co-pilot conversation"|xlt }}"></div>
    <div id="clinical-copilot-sources" class="mb-2 large" aria-label="{{ "Cited sources for last reply"|xlt }}"></div>
    <div id="clinical-copilot-overlay-wrap" class="mb-2" style="display:none;" aria-label="{{ "Extracted document regions (normalized overlay)"|xlt }}">
        <div class="font-weight-bold mb-1">{{ "Document region overlay (demo bbox)"|xlt }}</div>
        <p class="text-muted large mb-1">{{ "Approximate source regions on a letter-shaped placeholder; upload a PDF and run a briefing after extraction."|xlt }}</p>
        <div id="clinical-copilot-overlay-stage" class="copilot-bbox-stage" role="presentation"
             style="position:relative;width:100%;max-width:320px;aspect-ratio:8.5/11;background:#eef2f7;border:1px solid var(--of-border);border-radius:8px;"></div>
    </div>
    
    <form id="clinical-copilot-form" class="form-inline d-flex flex-wrap align-items-start" onsubmit="return false;">
        <label for="clinical-copilot-input" class="sr-only">{{ "Follow-up question"|xlt }}</label>
        <textarea id="clinical-copilot-input" class="form-control form-control-sm flex-grow-1 mr-1 mb-1" rows="2"
                  style="min-width: 12rem;"
                  placeholder="{{ "Ask a follow-up grounded in this chart…"|xlt }}"></textarea>
        <button type="button" class="btn btn-of-primary mb-1" id="clinical-copilot-send-btn">{{ "Send"|xlt }}</button>
    </form>
    <details class="large text-muted mt-1">
        <summary>{{ "Token usage (optional)"|xlt }}</summary>
        <pre id="clinical-copilot-meta" class="large mb-0 mt-1 bg-light p-2 border rounded" style="white-space:pre-wrap;max-height:8rem;overflow:auto;"></pre>
    </details>
</div>
<script>
(function () {
    var root = document.getElementById('clinical-copilot-root');
    if (!root) { return; }
    var transcript = document.getElementById('clinical-copilot-transcript');
    var input = document.getElementById('clinical-copilot-input');
    var sendBtn = document.getElementById('clinical-copilot-send-btn');
    var briefBtn = document.getElementById('clinical-copilot-brief-btn');
    var resetBtn = document.getElementById('clinical-copilot-reset-btn');
    var uploadBtn = document.getElementById('clinical-copilot-upload-btn');
    var fileInput = document.getElementById('clinical-copilot-file');
    var docTypeSel = document.getElementById('clinical-copilot-doctype');
    var meta = document.getElementById('clinical-copilot-meta');
    var sources = document.getElementById('clinical-copilot-sources');
    var overlayWrap = document.getElementById('clinical-copilot-overlay-wrap');
    var overlayStage = document.getElementById('clinical-copilot-overlay-stage');
    var url = (root.getAttribute('data-ajax-url') || '').trim();
    /* Collapse accidental "//path" (not "scheme://") so fetch stays same-origin. */
    if (url.indexOf('//') === 0 && url.indexOf('://') < 0) {
        url = url.replace(/^\/+/, '/');
    }
    var csrf = root.getAttribute('data-csrf');
    var conversationToken = null;

    function esc(s) {
        var d = document.createElement('div');
        d.textContent = s;
        return d.innerHTML;
    }

    function appendBubble(role, htmlBody) {
        var wrap = document.createElement('div');
        wrap.className = 'mb-2';
        var isUser = role === 'user';
        wrap.innerHTML = '<div class="d-flex ' + (isUser ? 'justify-content-end' : 'justify-content-start') + '">' +
            '<div class="copilot-bubble ' + (isUser ? 'copilot-user-bubble' : 'copilot-assistant-bubble') + '">' +
            '<span class="sr-only">' + esc(isUser ? 'You' : 'Assistant') + '</span>' + htmlBody + '</div></div>';
        transcript.appendChild(wrap);
        transcript.scrollTop = transcript.scrollHeight;
    }

    function renderStatementsForUi(items) {
        if (!items || !items.length) { return '<p class="mb-0 large">' + esc('(No verified statements.)') + '</p>'; }
        var html = '';
        for (var i = 0; i < items.length; i++) {
            var it = items[i];
            var sid = 'cc-s-' + Math.random().toString(36).slice(2, 9);
            var cites = it.citations || [];
            var citeHtml = '';
            if (cites.length) {
                citeHtml += '<ul class="list-unstyled large mb-0 mt-1 text-muted" aria-label="Sources">';
                for (var j = 0; j < cites.length; j++) {
                    var c = cites[j];
                    citeHtml += '<li><span class="font-weight-bold">' + esc(c.label || 'Source') + '</span>' +
                        '<span class="sr-only"> path </span><code class="large ml-1">' + esc(c.path || '') + '</code></li>';
                }
                citeHtml += '</ul>';
            }
            html += '<article class="mb-2" aria-labelledby="' + sid + '"><p id="' + sid + '" class="mb-0">' + esc(it.text || '') + '</p>' + citeHtml + '</article>';
        }
        return html;
    }

    function renderFromMessages(messages) {
        transcript.innerHTML = '';
        if (!messages || !messages.length) { return; }
        for (var i = 0; i < messages.length; i++) {
            var m = messages[i];
            if (!m || !m.role) { continue; }
            appendBubble(m.role, '<p class="mb-0 large" style="white-space:pre-wrap">' + esc(m.content || '') + '</p>');
        }
    }

    function jsonFromResponse(r) {
        return r.text().then(function (text) {
            var j = {};
            if (text) {
                try {
                    j = JSON.parse(text);
                } catch (ignore) {
                    j = { error: 'invalid_response', http_status: r.status };
                }
            }
            return { ok: r.ok, j: j };
        });
    }

    function post(body, cb) {
        if (!url) {
            cb({ ok: false, j: { error: 'missing_ajax_url' } });
            return;
        }
        var fd = new URLSearchParams();
        fd.set('csrf_token_form', csrf);
        for (var k in body) {
            if (Object.prototype.hasOwnProperty.call(body, k) && body[k] !== null && body[k] !== undefined) {
                fd.set(k, body[k]);
            }
        }
        fetch(url, {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: fd.toString()
        }).then(jsonFromResponse)
        .then(cb)
        .catch(function () { cb({ ok: false, j: { error: 'network' } }); });
    }

    function setBusy(b) {
        sendBtn.disabled = b;
        briefBtn.disabled = b;
        resetBtn.disabled = b;
        if (uploadBtn) { uploadBtn.disabled = b; }
    }

    function renderExtractionOverlays(items) {
        if (!overlayWrap || !overlayStage) { return; }
        overlayStage.innerHTML = '';
        if (!items || !items.length) {
            overlayWrap.style.display = 'none';
            return;
        }
        overlayWrap.style.display = 'block';
        for (var i = 0; i < items.length; i++) {
            var o = items[i];
            var b = o.bbox_norm;
            if (!b || typeof b.x !== 'number') { continue; }
            var d = document.createElement('div');
            d.setAttribute('role', 'img');
            d.setAttribute('aria-label', (o.label || 'region') + ' — ' + (o.path || ''));
            d.style.position = 'absolute';
            d.style.left = (b.x * 100) + '%';
            d.style.top = (b.y * 100) + '%';
            d.style.width = (b.w * 100) + '%';
            d.style.height = (b.h * 100) + '%';
            d.style.border = '2px solid rgba(23,166,114,0.95)';
            d.style.background = 'rgba(47,237,113,0.18)';
            d.style.boxSizing = 'border-box';
            d.style.pointerEvents = 'none';
            overlayStage.appendChild(d);
        }
    }

    function applyResponse(x) {
        var j = x.j || {};
        if (j.conversation_token) { conversationToken = j.conversation_token; }
        if (j.messages) { renderFromMessages(j.messages); }
        if (sources) {
            if (j.ok && j.statements_for_ui && j.statements_for_ui.length) {
                sources.innerHTML = '<div class="font-weight-bold mb-1">' + esc('Sources (last reply)') + '</div>' + renderStatementsForUi(j.statements_for_ui);
            } else {
                sources.innerHTML = '';
            }
        }
        renderExtractionOverlays(j.ok ? j.extraction_overlays : null);
        if (j.usage && meta) {
            meta.textContent = 'OpenAI TOKENS: ' + (j.usage.total_tokens || 0) + ', est. USD: ' + (j.estimated_usd || 0) + (j.model ? ', model: ' + j.model : '');
        }
    }

    briefBtn.addEventListener('click', function () {
        setBusy(true);
        post({ action: 'brief' }, function (x) {
            setBusy(false);
            if (x.j && x.j.ok) { applyResponse(x); }
            else {
                if (sources) { sources.innerHTML = ''; }
                appendBubble('assistant', '<p class="mb-0 large text-danger">' + esc((x.j && x.j.error) ? x.j.error : 'failed') + '</p>');
            }
        });
    });

    resetBtn.addEventListener('click', function () {
        setBusy(true);
        post({ action: 'reset' }, function (x) {
            setBusy(false);
            conversationToken = null;
            transcript.innerHTML = '';
            if (sources) { sources.innerHTML = ''; }
            if (meta) { meta.textContent = ''; }
            renderExtractionOverlays(null);
        });
    });

    function sendFollowUp() {
        var t = (input.value || '').trim();
        if (!t) { return; }
        if (!conversationToken) {
            appendBubble('assistant', '<p class="mb-0 large text-danger">' + esc('Run a briefing first.') + '</p>');
            return;
        }
        setBusy(true);
        post({ action: 'message', user_message: t, conversation_token: conversationToken }, function (x) {
            setBusy(false);
            input.value = '';
            if (x.j && x.j.ok) { applyResponse(x); }
            else {
                if (sources) { sources.innerHTML = ''; }
                appendBubble('assistant', '<p class="mb-0 large text-danger">' + esc((x.j && x.j.error) ? x.j.error : 'failed') + '</p>');
            }
        });
    }

    if (uploadBtn && fileInput && docTypeSel) {
        uploadBtn.addEventListener('click', function () {
            if (!fileInput.files || !fileInput.files[0]) {
                appendBubble('assistant', '<p class="mb-0 large text-warning">' + esc('Choose a PDF first.') + '</p>');
                return;
            }
            setBusy(true);
            var fd = new FormData();
            fd.set('csrf_token_form', csrf);
            fd.set('clinical_copilot_action', 'upload_document');
            fd.set('doc_type', docTypeSel.value || 'lab_pdf');
            fd.set('clinical_copilot_file', fileInput.files[0]);
            if (!url) {
                setBusy(false);
                appendBubble('assistant', '<p class="mb-0 large text-danger">' + esc('missing_ajax_url') + '</p>');
                return;
            }
            fetch(url, { method: 'POST', body: fd, credentials: 'same-origin' })
                .then(jsonFromResponse)
                .then(function (x) {
                    setBusy(false);
                    var j = x.j || {};
                    if (j.ok) {
                        var extra = (j.chart_document_id) ? (' ' + esc('Chart document id: ') + esc(String(j.chart_document_id))) : '';
                        appendBubble('assistant', '<p class="mb-0 large">' + esc('Document staged for this patient. Generate a briefing or ask a follow-up so the agent can process it.') + extra + '</p>');
                    } else {
                        appendBubble('assistant', '<p class="mb-0 large text-danger">' + esc(j.error || 'upload failed') + '</p>');
                    }
                })
                .catch(function () {
                    setBusy(false);
                    appendBubble('assistant', '<p class="mb-0 large text-danger">' + esc('network') + '</p>');
                });
        });
    }

    sendBtn.addEventListener('click', sendFollowUp);
    input.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            sendFollowUp();
        }
    });
})();
</script>
{% endblock %}
