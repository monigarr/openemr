# Langfuse variables for Clinical Co-Pilot (copy into Railway Variables or merge into a local .env).
# Do not commit real keys. See docker/agentforge-railway/README.md and
# interface/modules/custom_modules/oe-module-clinical-copilot/README.md

# Required for export (with OpenEMR Portal global clinical_copilot_langfuse_enable on):
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...

# Required for HIPAA cloud when using HIPAA project keys (otherwise app defaults to EU cloud):
# LANGFUSE_BASE_URL=https://hipaa.cloud.langfuse.com

# Optional alias if BASE_URL is unset:
# LANGFUSE_HOST=https://hipaa.cloud.langfuse.com

# Optional kill switch (set to 0/false to force-disable):
# LANGFUSE_ENABLED=1

# Optional trace attributes:
# LANGFUSE_RELEASE=staging
# LANGFUSE_TRACING_ENVIRONMENT=staging
# LANGFUSE_ENV=staging

# I/O mode: leave unset for metadata-only; use redacted only with compliance approval:
# LANGFUSE_CLINICAL_COPILOT_IO=redacted
# LANGFUSE_IO_MAX_CHARS=500

# Recommended opaque user/session hashing salt:
# LANGFUSE_ID_SALT=change-me-long-random
